+// Measurement build only (patches/medicao M02/M03, never in packages A or B): counts of the VU1 code paths and the
+// flag records, and the GIF breakdown. Written by the thread that runs the code (GameThread with PS2X_MTVU=0),
+// read by the bench thread once per second. Plain load + store (bump): no atomic read-modify-write in the hot paths.
+namespace ps2x_prof
+{
+    struct VuPathStats
+    {
+        // FMAC variants as the generated code calls them (see ps2_vu1_impl.inl).
+        std::atomic<uint64_t> fmacRing{0u};     // fmac<>: flags computed and pushed to the ring every op
+        std::atomic<uint64_t> fmacV{0u};        // fmacV<>: sticky flags accumulated in vectors
+        std::atomic<uint64_t> fmacF{0u};        // fmacF<>: flags computed, pushed by pushFmacFlags (segment's last FMAC)
+        std::atomic<uint64_t> fmacFastN{0u};    // fmacFastN<>: no flags (dead-flag analysis)
+        std::atomic<uint64_t> fmacFastV{0u};    // fmacFastV<>: sticky only
+        std::atomic<uint64_t> fastFallback{0u}; // fmacFast* that fell back to fmacV (saturating product)
+        std::atomic<uint64_t> fmacExact{0u};    // fmacExact (double precision), from any variant
+        // Flag records.
+        std::atomic<uint64_t> flagPush{0u}, clipPush{0u};
+        std::atomic<uint64_t> readEvents{0u};       // commitStatus: points where the program reads MAC/status
+        std::atomic<uint64_t> foldedAtRead{0u};     // records folded at those points
+        std::atomic<uint64_t> foldedAtOverflow{0u}; // records folded because the ring (32) was full
+        std::atomic<uint64_t> pendingAtEnd{0u};     // records still in the ring when a run returns (committed then)
+        // Other instruction kinds (helper calls).
+        std::atomic<uint64_t> writeVf{0u}, ldq{0u}, stq{0u}, divOp{0u}, clipOp{0u}, xgkick{0u};
+    };
+    inline VuPathStats g_vuPaths;
+    inline bool measOn()
+    {
+        static const bool on = enabledByEnvironment();
+        return on;
+    }
+#define PS2X_MEAS_BUMP(field) do { if (::ps2x_prof::measOn()) ::ps2x_prof::bump(::ps2x_prof::g_vuPaths.field, 1u); } while (0)
+#define PS2X_MEAS_ADD(field, n) do { if (::ps2x_prof::measOn()) ::ps2x_prof::bump(::ps2x_prof::g_vuPaths.field, (n)); } while (0)
+
+    // GIF: time inside GS::processGIFPacket split by what it does (exclusive), plus counts.
+    enum GifCat : uint8_t
+    {
+        GifParse = 0,  // tags, register decode, primitive assembly (everything not below)
+        GifLock,       // waiting for the GS state mutex
+        GifSubmit,     // handing primitive batches to the GS backend (GS thread queue; includes gs-wait when full)
+        GifFlush,      // backend Flush (push the pending batch to the GS thread)
+        GifSync,       // backend Sync: wait until the GS thread has finished (FINISH, readbacks...)
+        GifUpload,     // native image upload path (host -> VRAM)
+        GifOther,      // other backend calls: RawGif, CLUT loads, transfer begin, texture flush
+        GifCatCount
+    };
+    inline const char *const kGifNames[GifCatCount] = {"parse", "lock", "submit", "flush", "sync", "upload", "other"};
+    struct GifStats
+    {
+        std::atomic<uint64_t> ticks[GifCatCount] = {};
+        std::atomic<uint64_t> calls[GifCatCount] = {};
+        std::atomic<uint64_t> packets{0u}, bytes{0u}, tagsPacked{0u}, tagsReglist{0u}, tagsImage{0u}, regWrites{0u}, kicks{0u};
+    };
+    inline GifStats g_gif;
+    struct GifThreadState
+    {
+        int depth = 0;
+        uint8_t cur = GifParse;
+        uint64_t last = 0;
+    };
+    inline thread_local GifThreadState t_gif;
+    inline void gifAccount(uint64_t now)
+    {
+        bump(g_gif.ticks[t_gif.cur], now - t_gif.last);
+        t_gif.last = now;
+    }
+    struct GifPacketScope // one per processGIFPacket (re-entrant)
+    {
+        bool on;
+        explicit GifPacketScope(uint32_t bytes) : on(measOn())
+        {
+            if (!on) return;
+            if (t_gif.depth++ == 0) { t_gif.cur = GifParse; t_gif.last = ticks(); }
+            bump(g_gif.packets, 1u);
+            bump(g_gif.bytes, bytes);
+        }
+        ~GifPacketScope()
+        {
+            if (on && --t_gif.depth == 0) gifAccount(ticks());
+        }
+    };
+    struct GifSubScope // a part of the packet's work; inactive outside processGIFPacket
+    {
+        bool on;
+        uint8_t prev = GifParse;
+        explicit GifSubScope(uint8_t cat) : on(measOn() && t_gif.depth > 0)
+        {
+            if (!on) return;
+            gifAccount(ticks());
+            prev = t_gif.cur;
+            t_gif.cur = cat;
+            bump(g_gif.calls[cat], 1u);
+        }
+        ~GifSubScope()
+        {
+            if (!on) return;
+            gifAccount(ticks());
+            t_gif.cur = prev;
+        }
+    };
+    inline bool gifInside() { return measOn() && t_gif.depth > 0; }
+}
