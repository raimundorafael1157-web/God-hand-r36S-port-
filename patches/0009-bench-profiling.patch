diff --git a/runtime/ps2xRuntime/include/ps2_prof.h b/runtime/ps2xRuntime/include/ps2_prof.h
new file mode 100644
index 0000000..1c9d6ba
--- /dev/null
+++ b/runtime/ps2xRuntime/include/ps2_prof.h
@@ -0,0 +1,384 @@
+#pragma once
+// RK3326 port: where the GameThread spends its time, measured with the CPU's own counter. The GameThread runs the
+// recompiled EE code and, inline, the VU1 microprograms, part of the IOP, the scheduler and the GS/VIF front end: one
+// CPU-time number per thread does not say which of them is the bottleneck.
+//
+// Each subsystem entry point switches the GameThread's current section. A switch reads the counter (CNTVCT_EL0 on
+// ARM64, the TSC on x86-64), adds the time since the previous switch to the section being left, and records the new
+// one: exclusive time, so a VU1 microprogram started from EE code counts as vu1, not ee, and the sections add up to the
+// thread's wall time. Waiting is a section too: idle = the EE has nothing due yet or is ahead of real time (pacing);
+// gs-wait = blocked on the GS thread's queue; vu-wait = blocked on the VU1 worker thread (PS2X_MTVU=1).
+//
+// dispatch and sched are entered millions of times per second: timing every entry cost ~45% of the GameThread on the
+// PC. They are sampled instead (SampledScope): every call is counted, one in kSampleEvery on average is timed (picked
+// pseudo-randomly), and the total is
+// the timed share scaled by calls / timed calls. Their time is first charged to the section they ran inside (ee, as a
+// rule) and the report moves the estimate out of it, so the sections still add up to wall time.
+//
+// Nothing here changes what the emulator does: no branch of EE, VU, IOP, GS or scheduler logic looks at these values.
+// Off unless PS2X_PROF=1 together with PS2X_BENCH=1, decided once when the GameThread starts, so the plain benchmark
+// measures what it always did; off, a marker is one thread-local flag test. Other threads never count. ps2_bench.h reads the totals once per second.
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+
+#if defined(__x86_64__) || defined(_M_X64)
+#include <x86intrin.h>
+#endif
+
+namespace ps2x_prof
+{
+    enum Section : uint8_t
+    {
+        EE = 0,    // recompiled EE code and everything not marked below
+        VU1,       // VU1 microprograms (pre-compiled blocks or interpreter)
+        VU0,       // VU0 microprograms (macro mode is EE code)
+        IOP,       // IOP emulation entered from the GameThread
+        Dispatch,  // jumps and calls between recompiled functions (lookup, bookkeeping)
+        Sched,     // EE scheduler: full checkpoint path and cycle accounting
+        Gif,       // GIF packets: GS register writes, vertex kicks
+        Vif,       // VIF1 data: unpacks into VU1 memory
+        Idle,      // scheduler waits: nothing due yet, or the EE ahead of real time (spare time)
+        GsWait,    // blocked on the GS thread (queue full, drain)
+        VuWait,    // blocked on the VU1/VIF1 worker thread (PS2X_MTVU=1 only: otherwise VU1 runs inline, as vu1)
+        Count
+    };
+
+    inline const char *const kNames[Count] = {"ee", "vu1", "vu0", "iop", "dispatch", "sched", "gif", "vif", "idle", "gs-wait", "vu-wait"};
+
+    // The counter: CNTVCT_EL0 (ARM generic timer, 24 MHz on the RK3326), the TSC on x86-64, else steady_clock in ns.
+    inline uint64_t ticks()
+    {
+#if defined(__aarch64__)
+        uint64_t v;
+        asm volatile("mrs %0, cntvct_el0" : "=r"(v));
+        return v;
+#elif defined(__x86_64__) || defined(_M_X64)
+        return __rdtsc();
+#else
+        return static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                                         std::chrono::steady_clock::now().time_since_epoch())
+                                         .count());
+#endif
+    }
+
+    // Ticks per second when the hardware says so (CNTFRQ_EL0); 0 = calibrate against steady_clock (x86 TSC).
+    inline uint64_t ticksPerSecondFromHardware()
+    {
+#if defined(__aarch64__)
+        uint64_t f;
+        asm volatile("mrs %0, cntfrq_el0" : "=r"(f));
+        return f;
+#elif defined(__x86_64__) || defined(_M_X64)
+        return 0;
+#else
+        return 1000000000ull;
+#endif
+    }
+
+    // Written by the GameThread only (plain load + store, no read-modify-write), read by the bench thread.
+    struct Counters
+    {
+        std::atomic<uint64_t> ticks[Count];
+        std::atomic<uint64_t> switches{0};
+        std::atomic<uint64_t> lastStamp{0};   // when the current section started
+        std::atomic<uint8_t> current{EE};
+        std::atomic<bool> active{false};
+        Counters()
+        {
+            for (auto &t : ticks)
+                t.store(0, std::memory_order_relaxed);
+        }
+    };
+
+    inline Counters g_game;
+
+    constexpr uint32_t kSampleEvery = 128; // power of two
+
+    // Sampled sections (dispatch, sched): calls, timed calls, and the timed ticks split by the section they ran inside.
+    struct SampledCounters
+    {
+        std::atomic<uint64_t> calls[Count];
+        std::atomic<uint64_t> timed[Count];
+        std::atomic<uint64_t> ticksInside[Count][Count]; // [sampled section][section it ran inside]
+        std::atomic<uint64_t> intervalsInside[Count][Count]; // timed stretches behind those ticks (bias correction)
+        SampledCounters()
+        {
+            for (int i = 0; i < Count; ++i)
+            {
+                calls[i].store(0, std::memory_order_relaxed);
+                timed[i].store(0, std::memory_order_relaxed);
+                for (int j = 0; j < Count; ++j)
+                {
+                    ticksInside[i][j].store(0, std::memory_order_relaxed);
+                    intervalsInside[i][j].store(0, std::memory_order_relaxed);
+                }
+            }
+        }
+    };
+    inline SampledCounters g_sampled;
+
+    inline void bump(std::atomic<uint64_t> &a, uint64_t v) { a.store(a.load(std::memory_order_relaxed) + v, std::memory_order_relaxed); }
+
+    struct SampledScope;
+    struct ThreadState
+    {
+        bool counting = false;
+        uint8_t current = EE;
+        uint64_t last = 0;
+        uint32_t sampleState = 0x9E3779B9u; // xorshift32: which calls are timed
+        uint8_t sampledInside = Count;      // innermost sampled section we are in (Count = none)
+        SampledScope *timing = nullptr; // innermost sampled scope being timed
+    };
+    inline thread_local ThreadState t_state;
+
+    // The whole cost of one switch; ps2_bench.h times it on its own thread to report the overhead.
+    inline void account(Counters &c, ThreadState &s, uint8_t next)
+    {
+        const uint64_t now = ticks();
+        const uint8_t cur = s.current;
+        c.ticks[cur].store(c.ticks[cur].load(std::memory_order_relaxed) + (now - s.last), std::memory_order_relaxed);
+        s.last = now;
+        s.current = next;
+        c.lastStamp.store(now, std::memory_order_relaxed);
+        c.current.store(next, std::memory_order_relaxed);
+        c.switches.store(c.switches.load(std::memory_order_relaxed) + 1u, std::memory_order_relaxed);
+    }
+
+    inline bool enabledByEnvironment()
+    {
+        const char *bench = std::getenv("PS2X_BENCH");
+        const char *prof = std::getenv("PS2X_PROF");
+        return bench && std::strcmp(bench, "1") == 0 && prof && std::strcmp(prof, "1") == 0;
+    }
+
+    // Called once, first thing on the GameThread.
+    inline void registerGameThread()
+    {
+        if (!enabledByEnvironment())
+            return;
+        t_state.counting = true;
+        t_state.current = EE;
+        t_state.last = ticks();
+        g_game.lastStamp.store(t_state.last, std::memory_order_relaxed);
+        g_game.current.store(EE, std::memory_order_relaxed);
+        g_game.active.store(true, std::memory_order_release);
+    }
+
+    inline uint8_t current() { return t_state.current; }
+
+    inline void set(uint8_t section)
+    {
+        if (t_state.counting && section != t_state.current)
+            account(g_game, t_state, section);
+    }
+
+
+    // A dispatch or sched entry. Every call is counted; one in kSampleEvery on average is timed, picked pseudo-randomly
+    // and independently of any enclosing marker (forcing nested markers to time as well charged their own cost to the
+    // parent, x128). A timed stretch is charged to the section it ran inside: the enclosing sampled section if there is
+    // one (sched inside dispatch), else the exact section; combine() moves the estimates out in that order.
+    // pause()/resume() leave out a stretch that belongs elsewhere (the call into the target function, for dispatch).
+    struct SampledScope
+    {
+        SampledScope *parent = nullptr;   // enclosing timed scope (for exact sections to pause)
+        uint64_t start = 0, spent = 0;
+        uint32_t intervals = 0;           // timed stretches: each carries one counter read of bias
+        uint8_t section = 0, inside = 0, previousInside = Count;
+        bool counting = false, timed = false, paused = false;
+        bool exactPaused = false;         // paused by an exact section (Scope) running inside us
+
+        explicit SampledScope(uint8_t s)
+        {
+            ThreadState &t = t_state;
+            if (!t.counting)
+                return;
+            counting = true;
+            section = s;
+            previousInside = t.sampledInside;
+            inside = t.sampledInside != Count ? t.sampledInside : t.current;
+            t.sampledInside = s;
+            bump(g_sampled.calls[s], 1u);
+            // Not every Nth call: calls come in regular patterns (a dispatch, then a checkpoint, ...) and a fixed
+            // stride would time the same kind of call every time.
+            uint32_t x = t.sampleState;
+            x ^= x << 13;
+            x ^= x >> 17;
+            x ^= x << 5;
+            t.sampleState = x;
+            if ((x & (kSampleEvery - 1u)) != 0u)
+                return;
+            timed = true;
+            parent = t.timing;
+            t.timing = this;
+            start = ticks();
+        }
+        void stopClock()
+        {
+            if (timed && !paused)
+            {
+                spent += ticks() - start;
+                ++intervals;
+                paused = true;
+            }
+        }
+        void startClock()
+        {
+            if (timed && paused)
+            {
+                start = ticks();
+                paused = false;
+            }
+        }
+        void pause()
+        {
+            if (!counting)
+                return;
+            stopClock();
+            t_state.sampledInside = previousInside; // the target function runs in its caller's section
+        }
+        void resume()
+        {
+            if (!counting)
+                return;
+            t_state.sampledInside = section;
+            startClock();
+        }
+        ~SampledScope()
+        {
+            if (!counting)
+                return;
+            t_state.sampledInside = previousInside;
+            if (!timed)
+                return;
+            stopClock();
+            bump(g_sampled.timed[section], 1u);
+            bump(g_sampled.ticksInside[section][inside], spent);
+            bump(g_sampled.intervalsInside[section][inside], intervals);
+            t_state.timing = parent;
+        }
+        SampledScope(const SampledScope &) = delete;
+        SampledScope &operator=(const SampledScope &) = delete;
+    };
+
+    // An exact section (vu1, iop, gif, vif, idle, gs-wait...). Its time is its own: the clocks of the timed sampled
+    // scopes it runs inside stop meanwhile (the EE pacing wait, for one, sits inside the checkpoint path of a dispatch),
+    // and sampled markers inside it are charged to it, not to the dispatch around it.
+    struct Scope
+    {
+        uint8_t previous;
+        uint8_t previousInside = Count;
+        bool pausedSampled = false;
+        explicit Scope(uint8_t section) : previous(t_state.current)
+        {
+            ThreadState &t = t_state;
+            if (t.counting)
+            {
+                for (SampledScope *p = t.timing; p; p = p->parent)
+                    if (!p->paused)
+                    {
+                        p->stopClock();
+                        p->exactPaused = true;
+                        pausedSampled = true;
+                    }
+                previousInside = t.sampledInside;
+                t.sampledInside = Count;
+            }
+            set(section);
+        }
+        ~Scope()
+        {
+            set(previous);
+            ThreadState &t = t_state;
+            if (!t.counting)
+                return;
+            t.sampledInside = previousInside;
+            if (pausedSampled)
+                for (SampledScope *p = t.timing; p; p = p->parent)
+                    if (p->exactPaused)
+                    {
+                        p->exactPaused = false;
+                        p->startClock();
+                    }
+        }
+        Scope(const Scope &) = delete;
+        Scope &operator=(const Scope &) = delete;
+    };
+
+    // Totals so far, the running section included (bench thread). Approximate by at most one section switch.
+    inline void snapshot(uint64_t out[Count], uint64_t &switches)
+    {
+        for (int i = 0; i < Count; ++i)
+            out[i] = g_game.ticks[i].load(std::memory_order_relaxed);
+        switches = g_game.switches.load(std::memory_order_relaxed);
+        if (!g_game.active.load(std::memory_order_acquire))
+            return;
+        const uint64_t since = g_game.lastStamp.load(std::memory_order_relaxed);
+        const uint8_t cur = g_game.current.load(std::memory_order_relaxed);
+        const uint64_t now = ticks();
+        if (now > since && cur < Count)
+            out[cur] += now - since;
+    }
+
+    // Sampled sections' raw counters (bench thread): calls, timed calls, timed ticks by the section they ran inside.
+    struct SampledSnapshot
+    {
+        uint64_t calls[Count] = {}, timed[Count] = {}, inside[Count][Count] = {}, intervals[Count][Count] = {};
+    };
+    inline SampledSnapshot sampledSnapshot()
+    {
+        SampledSnapshot s;
+        for (int i = 0; i < Count; ++i)
+        {
+            s.calls[i] = g_sampled.calls[i].load(std::memory_order_relaxed);
+            s.timed[i] = g_sampled.timed[i].load(std::memory_order_relaxed);
+            for (int j = 0; j < Count; ++j)
+            {
+                s.inside[i][j] = g_sampled.ticksInside[i][j].load(std::memory_order_relaxed);
+                s.intervals[i][j] = g_sampled.intervalsInside[i][j].load(std::memory_order_relaxed);
+            }
+        }
+        return s;
+    }
+
+    // What a timed stretch measures when it holds no work at all: the cost of the counter read that closes it, in ticks
+    // (the average of back-to-back reads; a fraction of a tick with the RK3326's 24 MHz counter). Subtracted from every
+    // timed stretch: dispatch calls last tens of ns, and this bias alone made dispatch read ~2x its real time on the PC.
+    inline double emptyIntervalTicks()
+    {
+        constexpr int kReads = 1000000;
+        uint64_t sum = 0;
+        for (int i = 0; i < kReads; ++i)
+        {
+            const uint64_t a = ticks();
+            const uint64_t b = ticks();
+            sum += b - a;
+        }
+        return static_cast<double>(sum) / kReads;
+    }
+
+    // Exact section ticks over a window plus the sampled sections' scaled estimates: the estimates are moved out of the
+    // sections they ran inside. Inputs are window deltas; out[] adds up to the same total as exact[].
+    inline void combine(const uint64_t exact[Count], const SampledSnapshot &d, double intervalBias, double out[Count])
+    {
+        for (int i = 0; i < Count; ++i)
+            out[i] = static_cast<double>(exact[i]);
+        for (int s = 0; s < Count; ++s)
+        {
+            if (d.timed[s] == 0u)
+                continue;
+            const double scale = static_cast<double>(d.calls[s]) / static_cast<double>(d.timed[s]);
+            for (int p = 0; p < Count; ++p)
+            {
+                const double own = std::max(0.0, static_cast<double>(d.inside[s][p]) - static_cast<double>(d.intervals[s][p]) * intervalBias);
+                const double moved = std::min(out[p], own * scale);
+                out[p] -= moved;
+                out[s] += moved;
+            }
+        }
+    }
+}
