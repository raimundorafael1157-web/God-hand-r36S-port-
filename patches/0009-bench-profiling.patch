+                char part[48];
+                std::snprintf(part, sizeof(part), " %s=%.1f%%", ps2x_prof::kNames[i], 100.0 * sectionSum[i] / total);
+                sectionText += part;
+            }
+            const double costNs = switchCostNs();
+            const double sampledNs = sampledCostNs();
+            const double switchesPerSecond = switchesSum / n, sampledPerSecond = sampledCallsSum / n;
+            // Each Scope is two switches (in and out); the figures are per switch and per sampled marker.
+            const double overhead = 100.0 * (switchesPerSecond * costNs + sampledPerSecond * sampledNs) / 1e9;
+            std::fprintf(stderr, "[bench-sections] GameThread wall time:%s | switches/s=%.0f x %.1f ns + sampled markers/s=%.0f x %.1f ns -> overhead ~%.2f%% of the GameThread | counter read bias %.2f ticks\n",
+                         sectionText.c_str(), switchesPerSecond, costNs, sampledPerSecond, sampledNs, overhead, intervalBias);
+        }
+        // Long runs: does the speed hold once the device is hot?
+        const size_t m = std::min<size_t>(60u, speeds.size() / 2u);
+        if (m > 0u)
+        {
+            const auto avg = [](const std::vector<double> &v, size_t from, size_t count) {
+                double sum = 0.0;
+                for (size_t i = from; i < from + count; ++i)
+                    sum += v[i];
+                return sum / static_cast<double>(count);
+            };
+            const size_t last = speeds.size() - m;
+            const auto minPositive = [](const std::vector<double> &v) {
+                double best = 0.0;
+                for (double x : v)
+                    if (x > 0.0 && (best == 0.0 || x < best))
+                        best = x;
+                return best;
+            };
+            std::fprintf(stderr, "[bench-thermal] first %zu s: speed=%.0f%% temp=%.0fC | last %zu s: speed=%.0f%% temp=%.0fC | temp max=%.0fC | cpu cap min=%.0f MHz | gpu clock min=%.0f MHz (0 = n/a)\n",
+                         m, avg(speeds, 0, m), avg(temps, 0, m), m, avg(speeds, last, m), avg(temps, last, m),
+                         percentile(temps, 1.0), minPositive(maxClocks), minPositive(gpuClocks));
+        }
     }
 }
