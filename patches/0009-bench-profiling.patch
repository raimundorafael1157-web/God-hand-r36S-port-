+    inline std::string readSysText(const std::string &path)
+    {
+#if defined(__linux__)
+        FILE *file = std::fopen(path.c_str(), "r");
+        if (!file)
+            return {};
+        char buffer[128] = {};
+        const size_t n = std::fread(buffer, 1, sizeof(buffer) - 1, file);
+        std::fclose(file);
+        std::string text(buffer, n);
+        while (!text.empty() && (text.back() == '\n' || text.back() == ' '))
+            text.pop_back();
+        return text;
+#else
+        (void)path;
+        return {};
+#endif
+    }
