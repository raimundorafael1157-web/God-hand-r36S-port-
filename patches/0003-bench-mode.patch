 {
+    if (const char *nullGs = std::getenv("PS2X_GS_NULL"); nullGs && *nullGs == '1')
+    {
+        std::fprintf(stderr, "[gs] PS2X_GS_NULL=1: primitives are dropped (measurement build, no picture)\n");
+        return std::make_unique<GSNullRasterBackend>();
+    }
     const char *value = std::getenv("PS2X_GS_THREAD");
     const bool enabled = (value && *value) ? *value != '0' : s_enabledByDefault.load();
