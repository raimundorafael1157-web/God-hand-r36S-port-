diff --git a/runtime/ps2xRuntime/src/lib/ps2_bench.h b/runtime/ps2xRuntime/src/lib/ps2_bench.h
new file mode 100644
index 0000000..842f82d
--- /dev/null
+++ b/runtime/ps2xRuntime/src/lib/ps2_bench.h
@@ -0,0 +1,303 @@
+#pragma once
+// RK3326 port: the measurement loop of PS2X_BENCH=1 (ps2_runtime.cpp, PS2Runtime::run). It replaces the present loop
+// when there is no window: nothing is drawn, the game thread runs exactly as in a normal run, and this thread only
+// watches. Once per second it prints one [bench] line; at the end, one [bench-summary] line.
+//
+// What each number is:
+//   fields/s  - emulated vsync fields per second (the EE scheduler's vsync tick); 59.94 = PS2 real time.
+//   frames/s  - game frames per second, from the game's own per-frame hook (ps2_host_display::noteGameFrame; God
+//               Hand: its flip copy builder). 0 when the port installs no such hook: then read flips/s or disp/s.
+//   worst     - the longest gap between two game frames in the window (two flips when there is no frame hook), ms.
+//   flips/s   - changes of the displayed frame buffer's base page (FBP, bits 0-8 of GS DISPFB1/DISPFB2), sampled
+//               every 2 ms. A double-buffered game swaps FBP once per game frame, so this is its own frame rate.
+//   disp/s    - changes of anything in DISPFB1/DISPFB2 (FBP or the DBX/DBY offset). An interlaced game moves DBY every
+//               field, so disp/s can read 60 while flips/s reads the real 30. If flips/s is 0 and disp/s is not, the
+//               game flips by offset inside one buffer: then disp/s is the frame rate.
+//   cpu       - process CPU time / wall time (100% = one full core; 400% = all four RK3326 cores).
+//   threads   - CPU share of each busy thread (GameThread = recompiled EE code; VUThread, GSThread, GIFThread...).
+//   rss       - resident memory in MB (/proc/self/statm).
+// The first BENCH_WARMUP_SECONDS (PS2X_BENCH_WARMUP, default 20) are left out of the summary (boot and loading).
+// onSecond(t) runs once per printed line with the seconds since start (ps2_runtime.cpp uses it to load or save a
+// save state at a set time: PS2X_BENCH_LOAD_STATE / PS2X_BENCH_SAVE_STATE).
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <string>
+#include <thread>
+#include <vector>
+
+#if defined(__linux__)
+#include <dirent.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#endif
+
+namespace ps2x_bench
+{
+    struct ThreadSample
+    {
+        std::string name;
+        uint64_t ticks = 0;
+    };
+
+    inline std::map<int, ThreadSample> sampleThreads()
+    {
+        std::map<int, ThreadSample> out;
+#if defined(__linux__)
+        DIR *dir = opendir("/proc/self/task");
+        if (!dir)
+            return out;
+        while (dirent *entry = readdir(dir))
+        {
+            if (entry->d_name[0] == '.')
+                continue;
+            const int tid = std::atoi(entry->d_name);
+            const std::string path = std::string("/proc/self/task/") + entry->d_name + "/stat";
+            FILE *file = std::fopen(path.c_str(), "r");
+            if (!file)
+                continue;
+            char buffer[1024] = {};
+            const size_t n = std::fread(buffer, 1, sizeof(buffer) - 1, file);
+            std::fclose(file);
+            buffer[n] = '\0';
+            // "tid (comm) state ppid ... utime(14) stime(15)": comm may hold spaces, so parse after the last ')'.
+            const char *open = std::strchr(buffer, '(');
+            const char *close = std::strrchr(buffer, ')');
+            if (!open || !close || close < open)
+                continue;
+            ThreadSample sample;
+            sample.name.assign(open + 1, close);
+            const char *p = close + 2;
+            unsigned long long utime = 0, stime = 0;
+            int field = 3;
+            while (*p && field < 14)
+            {
+                if (*p == ' ')
+                    ++field;
+                ++p;
+            }
+            if (std::sscanf(p, "%llu %llu", &utime, &stime) == 2)
+                sample.ticks = utime + stime;
+            out[tid] = sample;
+        }
+        closedir(dir);
+#endif
+        return out;
+    }
+
+    inline double processCpuSeconds()
+    {
+#if defined(__linux__)
+        rusage usage{};
+        getrusage(RUSAGE_SELF, &usage);
+        return static_cast<double>(usage.ru_utime.tv_sec + usage.ru_stime.tv_sec) +
+               static_cast<double>(usage.ru_utime.tv_usec + usage.ru_stime.tv_usec) / 1e6;
+#else
+        return 0.0;
+#endif
+    }
+
+    inline double rssMegabytes()
+    {
+#if defined(__linux__)
+        FILE *file = std::fopen("/proc/self/statm", "r");
+        if (!file)
+            return 0.0;
+        unsigned long long size = 0, resident = 0;
+        const int got = std::fscanf(file, "%llu %llu", &size, &resident);
+        std::fclose(file);
+        if (got != 2)
+            return 0.0;
+        return static_cast<double>(resident) * static_cast<double>(sysconf(_SC_PAGESIZE)) / (1024.0 * 1024.0);
+#else
+        return 0.0;
+#endif
+    }
+
+    // Current CPU0 clock in MHz and the hottest thermal zone in degrees C (0 when unreadable): thermal throttling on a
+    // handheld shows up here before it shows up as a mystery slowdown.
+    inline int readSysInt(const char *path)
+    {
+#if defined(__linux__)
+        FILE *file = std::fopen(path, "r");
+        if (!file)
+            return 0;
+        long long value = 0;
+        const int got = std::fscanf(file, "%lld", &value);
+        std::fclose(file);
+        return got == 1 ? static_cast<int>(value) : 0;
+#else
+        (void)path;
+        return 0;
+#endif
+    }
+
+    inline int cpuMhz() { return readSysInt("/sys/devices/system/cpu/cpu0/cpufreq/scaling_cur_freq") / 1000; }
+
+    inline int hottestC()
+    {
+        int best = 0;
+        for (int i = 0; i < 8; ++i)
+        {
+            char path[64];
+            std::snprintf(path, sizeof(path), "/sys/class/thermal/thermal_zone%d/temp", i);
+            best = std::max(best, readSysInt(path));
+        }
+        return best > 1000 ? best / 1000 : best;
+    }
+
+    inline double percentile(std::vector<double> values, double p)
+    {
+        if (values.empty())
+            return 0.0;
+        std::sort(values.begin(), values.end());
+        const size_t index = static_cast<size_t>(p * static_cast<double>(values.size() - 1) + 0.5);
+        return values[std::min(index, values.size() - 1)];
+    }
+
+    // onPoll() runs every ~16 ms (ps2_runtime.cpp: input sampling, so PS2X_PAD_SCRIPT / PS2X_PAD_FIFO still drive the
+    // game with no window, as the present loop would).
+    // gameFrames() returns the running count of game frames (0 forever when the port has no frame hook).
+    template <typename Runtime, typename StopFn, typename SecondFn, typename PollFn, typename FramesFn>
+    void runLoop(Runtime &runtime, StopFn &&shouldStop, SecondFn &&onSecond, PollFn &&onPoll, FramesFn &&gameFrames)
+    {
+        using Clock = std::chrono::steady_clock;
+        const double warmup = [] {
+            const char *v = std::getenv("PS2X_BENCH_WARMUP");
+            return v && *v ? std::atof(v) : 20.0;
+        }();
+#if defined(__linux__)
+        const double ticksPerSecond = static_cast<double>(sysconf(_SC_CLK_TCK));
+#else
+        const double ticksPerSecond = 100.0;
+#endif
+        auto &gs = runtime.memory().gs();
+        const auto start = Clock::now();
+        auto windowStart = start;
+        auto lastFlip = start;
+        uint64_t startField = gs.vsyncTick.load(std::memory_order_relaxed);
+        uint64_t lastDispfb1 = __atomic_load_n(&gs.dispfb1, __ATOMIC_RELAXED);
+        uint64_t lastDispfb2 = __atomic_load_n(&gs.dispfb2, __ATOMIC_RELAXED);
+        uint32_t flips = 0, dispChanges = 0;
+        uint64_t lastFrames = gameFrames(), windowFrames = lastFrames;
+        auto lastFrame = start;
+        double worstFrameMs = 0.0;
+        constexpr uint64_t kFbpMask = 0x1FFu;
+        double worstGapMs = 0.0;
+        double cpuStart = processCpuSeconds();
+        auto threadsStart = sampleThreads();
+        std::vector<double> fieldRates, frameRates, flipRates, dispRates, worstGaps, rssValues;
+        double cpuSum = 0.0;
+
+        std::fprintf(stderr, "[bench] started; warmup %.0f s excluded from the summary\n", warmup);
+        auto lastPoll = start;
+        while (!shouldStop())
+        {
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+            const auto now = Clock::now();
+            if (now - lastPoll >= std::chrono::milliseconds(16))
+            {
+                lastPoll = now;
+                onPoll();
+            }
+            const uint64_t d1 = __atomic_load_n(&gs.dispfb1, __ATOMIC_RELAXED);
+            const uint64_t d2 = __atomic_load_n(&gs.dispfb2, __ATOMIC_RELAXED);
+            if (const uint64_t f = gameFrames(); f != lastFrames)
+            {
+                lastFrames = f;
+                worstFrameMs = std::max(worstFrameMs, std::chrono::duration<double, std::milli>(now - lastFrame).count());
+                lastFrame = now;
+            }
+            if (d1 != lastDispfb1 || d2 != lastDispfb2)
+            {
+                ++dispChanges;
+                if ((d1 & kFbpMask) != (lastDispfb1 & kFbpMask) || (d2 & kFbpMask) != (lastDispfb2 & kFbpMask))
+                {
+                    ++flips;
+                    worstGapMs = std::max(worstGapMs, std::chrono::duration<double, std::milli>(now - lastFlip).count());
+                    lastFlip = now;
+                }
+                lastDispfb1 = d1;
+                lastDispfb2 = d2;
+            }
+            const double seconds = std::chrono::duration<double>(now - windowStart).count();
+            if (seconds < 1.0)
+                continue;
+
+            const uint64_t field = gs.vsyncTick.load(std::memory_order_relaxed);
+            const double cpuNow = processCpuSeconds();
+            const auto threadsNow = sampleThreads();
+            const double fieldRate = static_cast<double>(field - startField) / seconds;
+            const double flipRate = static_cast<double>(flips) / seconds;
+            const double dispRate = static_cast<double>(dispChanges) / seconds;
+            const double frameRate = static_cast<double>(lastFrames - windowFrames) / seconds;
+            const double worstMs = lastFrames != 0u ? worstFrameMs : worstGapMs;
+            const double cpu = 100.0 * (cpuNow - cpuStart) / seconds;
+            const double rss = rssMegabytes();
+            const double t = std::chrono::duration<double>(now - start).count();
+
+            std::string threadText;
+            for (const auto &[tid, sample] : threadsNow)
+            {
+                const auto before = threadsStart.find(tid);
+                const uint64_t base = before != threadsStart.end() ? before->second.ticks : 0u;
+                const double share = 100.0 * static_cast<double>(sample.ticks - base) / ticksPerSecond / seconds;
+                if (share < 3.0)
+                    continue;
+                char part[96];
+                std::snprintf(part, sizeof(part), " %s=%.0f%%", sample.name.c_str(), share);
+                threadText += part;
+            }
+            std::fprintf(stderr, "[bench] t=%.0f fields/s=%.1f speed=%.0f%% frames/s=%.1f flips/s=%.1f disp/s=%.1f worst=%.0fms cpu=%.0f%% rss=%.0fMB mhz=%d temp=%dC |%s\n",
+                         t, fieldRate, 100.0 * fieldRate / 59.94, frameRate, flipRate, dispRate, worstMs, cpu, rss, cpuMhz(), hottestC(), threadText.c_str());
+
+            onSecond(t);
+            if (t >= warmup)
+            {
+                fieldRates.push_back(fieldRate);
+                flipRates.push_back(flipRate);
+                frameRates.push_back(frameRate);
+                dispRates.push_back(dispRate);
+                worstGaps.push_back(worstMs);
+                rssValues.push_back(rss);
+                cpuSum += cpu;
+            }
+            windowStart = now;
+            startField = field;
+            flips = 0;
+            dispChanges = 0;
+            windowFrames = lastFrames;
+            worstFrameMs = 0.0;
+            worstGapMs = 0.0;
+            cpuStart = cpuNow;
+            threadsStart = threadsNow;
+        }
+
+        if (fieldRates.empty())
+        {
+            std::fprintf(stderr, "[bench-summary] run ended inside the warmup: no summary\n");
+            return;
+        }
+        const auto mean = [](const std::vector<double> &v) {
+            double sum = 0.0;
+            for (double x : v)
+                sum += x;
+            return v.empty() ? 0.0 : sum / static_cast<double>(v.size());
+        };
+        const double n = static_cast<double>(fieldRates.size());
+        // speed is the number that decides: below ~100% the game runs in slow motion (PS2 games step their logic per
+        // frame), it does not drop frames to keep up.
+        std::fprintf(stderr,
+                     "[bench-summary] seconds=%.0f speed avg=%.0f%% p5=%.0f%% | fields/s avg=%.1f | frames/s avg=%.1f p5=%.1f | flips/s avg=%.1f p5=%.1f | disp/s avg=%.1f | worst gap p95=%.0fms max=%.0fms | cpu avg=%.0f%% | rss max=%.0fMB\n",
+                     n, 100.0 * mean(fieldRates) / 59.94, 100.0 * percentile(fieldRates, 0.05) / 59.94, mean(fieldRates),
+                     mean(frameRates), percentile(frameRates, 0.05),
+                     mean(flipRates), percentile(flipRates, 0.05), mean(dispRates), percentile(worstGaps, 0.95),
+                     percentile(worstGaps, 1.0), cpuSum / n, percentile(rssValues, 1.0));
+    }
+}
