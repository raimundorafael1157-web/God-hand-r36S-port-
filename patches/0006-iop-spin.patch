+                    // RK3326 port: PS2X_IOP_SPIN_US sets this spin (default 2000 us, as before). On a handheld a shorter
+                    // spin keeps a core from sitting at 100% between batches (heat, clock throttling) at the cost of a
+                    // wake-up delay; the bench mode measures both.
+                    static const auto kSpin = []
+                    {
+                        const char *value = std::getenv("PS2X_IOP_SPIN_US");
+                        const long us = value && *value ? std::strtol(value, nullptr, 10) : 2000L;
